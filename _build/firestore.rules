rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // A signed-in user's own profile: saved places, home postcode, alert choices.
    match /profiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Deals the user opened (only if they switched on visit emails).
      match /visits/{visitId} {
        allow read, create, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public like counts. Each person (even anonymous) counts once.
    match /likes/{vid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1
        && existsAfter(/databases/$(db)/documents/likes/$(vid)/by/$(request.auth.uid));
      allow update: if request.auth != null && request.resource.data.keys().hasOnly(['n']) && (
        (request.resource.data.n == resource.data.n + 1
          && !exists(/databases/$(db)/documents/likes/$(vid)/by/$(request.auth.uid))
          && existsAfter(/databases/$(db)/documents/likes/$(vid)/by/$(request.auth.uid)))
        ||
        (request.resource.data.n == resource.data.n - 1
          && exists(/databases/$(db)/documents/likes/$(vid)/by/$(request.auth.uid))
          && !existsAfter(/databases/$(db)/documents/likes/$(vid)/by/$(request.auth.uid))));
      match /by/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && getAfter(/databases/$(db)/documents/likes/$(vid)).data.n is int;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public diner ratings (1-5 stars). Real (non-anonymous) accounts only, one per person per place.
    match /ratings/{vid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['sum', 'n'])
        && existsAfter(/databases/$(db)/documents/ratings/$(vid)/by/$(request.auth.uid))
        && request.resource.data.n == (resource == null ? 0 : resource.data.n)
             + (exists(/databases/$(db)/documents/ratings/$(vid)/by/$(request.auth.uid)) ? 0 : 1)
        && request.resource.data.sum == (resource == null ? 0 : resource.data.sum)
             + getAfter(/databases/$(db)/documents/ratings/$(vid)/by/$(request.auth.uid)).data.stars
             - (exists(/databases/$(db)/documents/ratings/$(vid)/by/$(request.auth.uid))
                ? get(/databases/$(db)/documents/ratings/$(vid)/by/$(request.auth.uid)).data.stars : 0);
      match /by/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.resource.data.keys().hasOnly(['stars', 'at'])
          && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && getAfter(/databases/$(db)/documents/ratings/$(vid)).data.n is int;
      }
    }

    // Half-Price Friday newsletter sign-ups. Written from the site, one per browser or account. Never public.
    match /subscribers/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'lang', 'area', 'consent', 'at'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 5
        && request.resource.data.area is string && request.resource.data.area.size() <= 60
        && request.resource.data.consent == true
        && request.resource.data.at == request.time;
    }

    // Anonymous monthly click counts per platform (no personal data). Public read so the numbers can be shown to partners.
    match /clicks/{month} {
      allow read: if true;
      allow create: if month.matches('^20[0-9][0-9]-[01][0-9]$')
        && request.resource.data.keys().size() == 1
        && request.resource.data.keys()[0].matches('^[a-z0-9]{2,24}$')
        && request.resource.data[request.resource.data.keys()[0]] == 1;
      allow update: if month.matches('^20[0-9][0-9]-[01][0-9]$')
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && request.resource.data.diff(resource.data).affectedKeys().toList()[0].matches('^[a-z0-9]{2,24}$')
        && request.resource.data[request.resource.data.diff(resource.data).affectedKeys().toList()[0]]
           == resource.data.get(request.resource.data.diff(resource.data).affectedKeys().toList()[0], 0) + 1;
    }
  }
}
