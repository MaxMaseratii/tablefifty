rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // The TableFifty owner. Only these signed-in, verified email addresses can open the admin page data.
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['info@tablefifty.co.uk', 'infotrade@maxmaserati.com'];
    }
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function myEmail() { return request.auth.token.email != null ? request.auth.token.email.lower() : null; }

    // A signed-in user's own profile: saved places, home postcode, alert choices.
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['favs', 'home', 'alerts', 'alertsAt', 'feedback', 'email', 'lang', 'updated', 'name'])
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 500))
        && (!('home' in request.resource.data) || request.resource.data.home == null || (request.resource.data.home is string && request.resource.data.home.size() <= 80))
        && (!('alerts' in request.resource.data) || request.resource.data.alerts is bool)
        && (!('feedback' in request.resource.data) || request.resource.data.feedback is bool)
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 40))
        && (!('lang' in request.resource.data) || (request.resource.data.lang is string && request.resource.data.lang.size() <= 5))
        && (!('alertsAt' in request.resource.data) || (request.resource.data.alertsAt is string && request.resource.data.alertsAt.size() <= 10))
        // the email on a profile can only be the account's own sign-in email (nobody can sign up someone else)
        && (!('email' in request.resource.data) || request.resource.data.email == null || request.resource.data.email == myEmail());
      // The owner can switch off someone's deal alerts when they ask (and nothing else).
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alerts']) && request.resource.data.alerts == false;
      // Deals the user opened (only if they switched on visit emails). Firestore deletes each one by itself 30 days later (TTL policy on 'expireAt').
      match /visits/{visitId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['vid', 'name', 'area', 'url', 'lang', 'at', 'asked', 'expireAt'])
          && (!('expireAt' in request.resource.data) || request.resource.data.expireAt is timestamp)
          && request.resource.data.name is string && request.resource.data.name.size() <= 100
          && request.resource.data.url is string && request.resource.data.url.size() <= 600;
      }
      // Private food diary: only the owner can read or write. Up to 4 photos (shrunk in the browser) per visit.
      match /diary/{entryId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.resource.data.keys().hasOnly(['vid', 'name', 'area', 'city', 'date', 'stars', 'dish', 'with', 'note', 'photos', 'caps', 'best', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.date is string && request.resource.data.date.matches('^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$')
          && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 5
          && request.resource.data.note is string && request.resource.data.note.size() <= 600
          && request.resource.data.photos is list && request.resource.data.photos.size() <= 4
          && (!('caps' in request.resource.data) || (request.resource.data.caps is list && request.resource.data.caps.size() <= 4))
          && request.resource.data.best is int;
      }
    }

    // Public like counts. Each person (even anonymous) counts once.
    match /likes/{vid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1
        && existsAfter(/databases/$(db)/documents/likes/$(vid)/by/$(request.auth.uid));
      allow update: if request.auth != null && request.resource.data.keys().hasOnly(['n']) && (
        (request.resource.data.n == resource.data.n + 1
          && !exists(/databases/$(db)/documents/likes/$(vid)/by/$(request.auth.uid))
          && existsAfter(/databases/$(db)/documents/likes/$(vid)/by/$(request.auth.uid)))
        ||
        (request.resource.data.n == resource.data.n - 1
          && exists(/databases/$(db)/documents/likes/$(vid)/by/$(request.auth.uid))
          && !existsAfter(/databases/$(db)/documents/likes/$(vid)/by/$(request.auth.uid))));
      match /by/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && getAfter(/databases/$(db)/documents/likes/$(vid)).data.n is int;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public diner ratings (1-5 stars). Real (non-anonymous) accounts only, one per person per place.
    match /ratings/{vid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['sum', 'n'])
        && existsAfter(/databases/$(db)/documents/ratings/$(vid)/by/$(request.auth.uid))
        && request.resource.data.n == (resource == null ? 0 : resource.data.n)
             + (exists(/databases/$(db)/documents/ratings/$(vid)/by/$(request.auth.uid)) ? 0 : 1)
        && request.resource.data.sum == (resource == null ? 0 : resource.data.sum)
             + getAfter(/databases/$(db)/documents/ratings/$(vid)/by/$(request.auth.uid)).data.stars
             - (exists(/databases/$(db)/documents/ratings/$(vid)/by/$(request.auth.uid))
                ? get(/databases/$(db)/documents/ratings/$(vid)/by/$(request.auth.uid)).data.stars : 0);
      match /by/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.resource.data.keys().hasOnly(['stars', 'at'])
          && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && getAfter(/databases/$(db)/documents/ratings/$(vid)).data.n is int;
      }
    }

    // Half-Price Friday newsletter sign-ups. Never public. Double opt-in: a sign-up is only saved by a signed-in account
    // whose email is confirmed (they opened our email link), and only with that same email address.
    match /subscribers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['email', 'lang', 'area', 'consent', 'vf', 'at'])
        && request.resource.data.email == myEmail()
        && request.resource.data.vf == true
        && request.resource.data.lang is string && request.resource.data.lang.size() <= 5
        && request.resource.data.area is string && request.resource.data.area.size() <= 60
        && request.resource.data.consent == true
        && request.resource.data.at == request.time;
    }

    // Anonymous counters (no personal data): one small document per counter, e.g. clicks/2026-10/k/firsttable = {n: 42}.
    // Anyone can add exactly 1. Public read so the numbers can be shown to partners. (The old one-document-per-month
    // format could only ever count to 1, because rules cannot read which single field changed.)
    match /clicks/{month} {
      allow read: if true;
      match /k/{key} {
        allow read: if true;
        allow create: if month.matches('^20[0-9][0-9]-[01][0-9]$') && key.matches('^[a-z0-9]{2,24}$')
          && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
        allow update: if month.matches('^20[0-9][0-9]-[01][0-9]$') && key.matches('^[a-z0-9]{2,24}$')
          && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      }
    }
  }
}
